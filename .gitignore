node_modules/
dist/
# the release body CI cuts out of CHANGELOG.md
RELEASE_NOTES.md
src-tauri/target/
src-tauri/gen/schemas/
*.log

# scripts/ used to be ignored wholesale, which quietly kept every helper
# package.json calls — start, test, ship, deb — out of the repository, so a
# fresh clone had a package.json pointing at files that were not there.
# Ignore what is generated in there, not the directory.
scripts/*.local.*

# runtime data, written next to the executable — the leading slash matters,
# or src/assets/sounds (the bundled alerts) would be ignored too
settings.json
shopping.json
positions.json
carried.json
runs.json
# every capture, however it was named on the way in: these carry the session
# identifier and checksum a client signs its requests with
debug-capture*.jsonl
/sounds/

# datamined item tables: input for tools/gen_items.py, not ours to ship
tools/data/
tools/__pycache__/

# local notes, not part of the published project
docs/

# locally built Linux packages for testing
linux-packages/

# a look at the icon, made by tools/gen_icon.py --preview
src-tauri/icons/preview.png

# swatch sheet from tools/gen_theme.py --preview
src/theme-preview.png

# sheet from tools/gen_skin.py --preview
src/skin-preview.png

dist-linux/

# machine-specific paths; see .env.example
.env

# artifacts gathered by `npm run all`
release/

# The update signing key, wherever it is put. It normally lives outside the
# checkout entirely (~/.tauri), and this is the belt to that pair of braces:
# a key committed once is a key that has to be rotated, and rotating it means
# every install already out there stops accepting updates.
*.key
*.key.pub
