# Where things are on your machine. Copy this file to .env and edit it.
# .env is git-ignored; this one is committed and is the documentation.
#
# Every value is optional: the scripts guess first and only ask when the guess
# is wrong. An environment variable of the same name beats what is written here.

# The game's bin folder — data.win, Hero_Siege.exe and the translation tables.
HERO_SIEGE_BIN=C:/Program Files (x86)/Steam/steamapps/common/HeroSiege/bin

# The extractor that reads the game. A separate tool in a separate folder: it
# knows about Hero Siege, not about this app. Defaults to a sibling of this
# checkout named "HeroSiege Extractor".
HS_EXTRACTOR=../HeroSiege Extractor

# Windows only. A Visual Studio whose CRT headers are actually installed —
# cargo finds a compiler by looking for cl.exe, not by checking that it works,
# so a broken installation is found first and every build dies in vswhom-sys.
VCVARS=C:/Program Files/Microsoft Visual Studio/2022/BuildTools/VC/Auxiliary/Build/vcvars64.bat

# The private half of the key that signs a release. The app installs nothing it
# did not sign, so it lives outside the checkout; `npx tauri signer generate -w
# <path>` writes it and the public half belongs in src-tauri/tauri.conf.json.
# Defaults to ~/.tauri/hs-tracker.key.
TAURI_SIGNING_PRIVATE_KEY_PATH=C:/Users/you/.tauri/hs-tracker.key

# Its password, if it has one. Empty is a password; unset is a prompt.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
