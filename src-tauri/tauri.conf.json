{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HS Tracker",
  "version": "1.1.3",
  "identifier": "com.hstracker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dashboard",
        "title": "HS Tracker",
        "width": 720,
        "height": 620,
        "resizable": true,
        "visible": true,
        "alwaysOnTop": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": false,
        "center": true,
        "minWidth": 620,
        "minHeight": 460
      },
      {
        "label": "main",
        "title": "HS Tracker — Overlay",
        "width": 444,
        "height": 199,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "ticker",
        "title": "HS Tracker Ticker",
        "width": 444,
        "height": 170,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/sounds/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Hero Siege session tracker overlay",
    "longDescription": "A session overlay for Hero Siege. It shows gold, experience, kills and every drop worth hearing about on top of the game, and reads them from the game's own network traffic — nothing is injected, no memory is read and nothing is sent anywhere.",
    "category": "Game",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 HS Tracker contributors",
    "linux": {
      "deb": {
        "depends": [
          "libpcap0.8",
          "libcap2-bin",
          "xdg-utils",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ],
        "postInstallScript": "installer/grant-capture-rights.sh"
      },
      "rpm": {
        "depends": [
          "libpcap",
          "libcap",
          "xdg-utils",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ],
        "postInstallScript": "installer/grant-capture-rights.sh"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "compression": "lzma",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
